# Public frontend build configuration. Never put backend/desktop secrets here.
# Optional Identity catalog bootstrap and original public-address read location. Publication uses the board connection.
VITE_PUBLIC_BOARD_ORIGIN=
# Optional Identity portal origin. Leave empty to keep local guest onboarding unchanged.
VITE_IDENTITY_ORIGIN=
# Empty URL/key disables external diagnostics. Device opt-out is separate.
VITE_SYNC_TELEMETRY_URL=
VITE_OTEL_EXPORTER_OTLP_ENDPOINT=
VITE_SYNC_TELEMETRY_PROJECT=tincanban
VITE_SYNC_TELEMETRY_BROWSER_KEY=
VITE_SYNC_TELEMETRY_LEVEL=all
VITE_SYNC_TELEMETRY_SAMPLE_RATE=1
VITE_SYNC_TELEMETRY_BATCH_SIZE=50
# Temporary startup crash checkpoints, delivered before each heavy stage.
VITE_STARTUP_DIAGNOSTICS=0
