{
  "name": "tincanban",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "vendor/meta-mesh/packages/*"
  ],
  "scripts": {
    "quality": "npm run quality:types && npm run quality:lint && npm run quality:dead && npm run quality:deps && npm run quality:dup && npm run quality:patterns",
    "dev": "vite",
    "build": "vue-tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:rusty-management": "vitest run --config vitest.rusty.config.ts",
    "test:e2e": "playwright test",
    "quality:types": "vue-tsc -p tsconfig.app.json --noEmit",
    "quality:lint": "eslint src",
    "quality:dead": "knip",
    "quality:deps": "depcruise src --config .dependency-cruiser.cjs --output-type err-long",
    "quality:dup": "jscpd src --config .jscpd.json",
    "quality:patterns": "ast-grep test --config sgconfig.yml --test-dir quality-rule-tests --skip-snapshot-tests && ast-grep scan src --config sgconfig.yml --report-style short",
    "quality:size": "node --test scripts/build-budget-files.test.mjs && npm run build && size-limit",
    "verify:meta-mesh": "node scripts/verify-meta-mesh.mjs",
    "test:coverage": "vitest run --coverage",
    "test:e2e:coverage": "TINCANBAN_E2E_COVERAGE=1 playwright test --project=core && node scripts/e2e-coverage.mjs",
    "test:e2e:public-board": "node scripts/public-board-e2e.mjs",
    "test:e2e:policy": "npm run build && playwright test --config playwright.policy.config.ts",
    "verify:policy": "node vendor/meta-mesh/scripts/verify-policy-deps.mjs",
    "test:e2e:discussions": "playwright test --config playwright.discussions.config.ts",
    "test:inventory": "node scripts/test-description-inventory.mjs"
  },
  "dependencies": {
    "@automerge/automerge": "^3.4.1",
    "@mdit/plugin-tasklist": "^1.1.3",
    "@meta-uber/mesh-blob": "file:vendor/meta-mesh/packages/mesh-blob",
    "@meta-uber/mesh-browser-store": "file:vendor/meta-mesh/packages/mesh-browser-store",
    "@meta-uber/mesh-identity": "file:vendor/meta-mesh/packages/mesh-identity",
    "@meta-uber/mesh-instance": "file:vendor/meta-mesh/packages/mesh-instance",
    "@meta-uber/mesh-pairing": "file:vendor/meta-mesh/packages/mesh-pairing",
    "@meta-uber/mesh-peer-store": "file:vendor/meta-mesh/packages/mesh-peer-store",
    "@meta-uber/mesh-replication": "file:vendor/meta-mesh/packages/mesh-replication",
    "@meta-uber/mesh-runtime": "file:vendor/meta-mesh/packages/mesh-runtime",
    "@meta-uber/mesh-transport": "file:vendor/meta-mesh/packages/mesh-transport",
    "@meta-uber/mesh-workspace": "file:vendor/meta-mesh/packages/mesh-workspace",
    "@noble/hashes": "2.4.0",
    "fflate": "^0.8.2",
    "markdown-it": "^15.0.2",
    "qrcode": "^1.5.4",
    "vue": "^3.5.18",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.45.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.55.0",
    "@size-limit/file": "14.0.0",
    "@types/node": "^26.6.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "4.1.11",
    "dependency-cruiser": "18.4.0",
    "eslint": "10.11.0",
    "eslint-plugin-vue": "10.11.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "17.12.0",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-report": "3.0.1",
    "istanbul-reports": "3.2.0",
    "jscpd": "5.3.0",
    "knip": "6.37.0",
    "size-limit": "14.0.0",
    "terser": "^5.51.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "8.70.0",
    "v8-to-istanbul": "9.3.0",
    "vite": "^7.1.3",
    "vitest": "4.1.11",
    "vue-tsc": "^2.2.12"
  }
}
