{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "meta-frontend-tincanban",
  "account_id": "c339afab5539aa748cb654d8281d4fff",
  "main": "frontend.mjs",
  "compatibility_date": "2026-10-09",
  "workers_dev": false,
  "routes": [
    { "pattern": "match.meta-uber-engineer.dev", "custom_domain": true },
    { "pattern": "tincanban.meta-uber-engineer.dev", "custom_domain": true }
  ],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "preview_urls": false,
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
