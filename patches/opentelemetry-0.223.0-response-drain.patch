+/** Backport the upstream response drain: keep quota charged until the body ends. */
+async function drainResponseBody(response) {
+    try {
+        const body = response.body;
+        if (body == null) return;
+        const reader = body.getReader();
+        try {
+            let chunk = await reader.read();
+            while (!chunk.done) chunk = await reader.read();
+        } finally {
+            reader.releaseLock();
+        }
+    } catch {
+        // Response headers already determined the export outcome.
     }
